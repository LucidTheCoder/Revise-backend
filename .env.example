# Study Platform Backend Environment Configuration
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port the server runs on (default: 5000, Render sets this automatically)
PORT=5000

# Environment mode (development, production)
NODE_ENV=development

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# ============================================================================
# DATABASE CONFIGURATION (Choose one)
# ============================================================================

# Database type: "json" (default), "mongodb", "postgresql"
DATABASE_TYPE=json

# MongoDB Connection String (if using MongoDB)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/study-platform

# PostgreSQL Connection String (if using PostgreSQL)
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/study_platform

# ============================================================================
# OPTIONAL: THIRD-PARTY SERVICES
# ============================================================================

# JWT Secret for authentication (when implementing auth)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email service configuration (for notifications)
SMTP_EMAIL=noreply@example.com
SMTP_PASSWORD=your-email-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Enable debug logging
DEBUG=false

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================================================
# NOTES
# ============================================================================
# 1. For Render deployment:
#    - PORT is automatically set by Render (no need to change)
#    - Set other variables in Render dashboard under Settings > Environment
#
# 2. Database Setup:
#    - Currently uses JSON files in ./data directory
#    - For production: switch to MongoDB/PostgreSQL
#    - See README.md for migration steps
#
# 3. Security:
#    - Change JWT_SECRET to a strong random value
#    - Never commit .env file to git
#    - Use strong database passwords
#    - Enable HTTPS in production
